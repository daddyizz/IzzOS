<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!-- OrangeFox recovery core is overlaid from the official fox_14.1 tree. -->
    <remove-project name="android_bootable_recovery" />
    <remove-project name="android_cts" />

    <!-- Host-only or ABI payloads omitted to keep the recovery build under 32 GiB. -->
    <remove-project name="platform/prebuilts/abi-dumps/ndk" />
    <remove-project name="platform/prebuilts/abi-dumps/platform" />
    <remove-project name="platform/prebuilts/abi-dumps/vndk" />
    <remove-project name="platform/prebuilts/bazel/darwin-x86_64" />
    <remove-project name="platform/prebuilts/clang/host/linux-x86" />
    <remove-project name="platform/prebuilts/jdk/jdk8" />
    <remove-project name="platform/prebuilts/jdk/jdk11" />
    <remove-project name="platform/prebuilts/jdk/jdk21" />
    <remove-project name="platform/prebuilts/misc" />
    <remove-project name="platform/prebuilts/rust" />
    <remove-project name="platform/prebuilts/sdk" />
    <remove-project name="platform/prebuilts/vndk/v29" />
    <remove-project name="platform/prebuilts/vndk/v30" />
    <remove-project name="platform/prebuilts/vndk/v31" />
    <remove-project name="platform/prebuilts/vndk/v32" />
    <remove-project name="platform/prebuilts/vndk/v33" />
    <remove-project name="platform/prebuilts/vndk/v34" />
    <remove-project name="kernel/prebuilts/5.15/x86-64" />
    <remove-project name="kernel/prebuilts/6.6/x86-64" />

    <remove-project name="phhusson/vendor_lptools" />
    <project path="external/lptools" name="phhusson/vendor_lptools" remote="github" revision="master" />

    <!-- Pair TeamWin 14.1 with the Android 14 QPR3 release graph. -->
    <remove-project name="android_build" />
    <remove-project name="android_build_soong" />
    <project path="build/make" name="android_build" remote="TeamWin" revision="android-14.1" groups="pdk">
        <copyfile src="core/root.mk" dest="Makefile" />
        <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
        <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
        <linkfile src="core" dest="build/core" />
        <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
        <linkfile src="target" dest="build/target" />
        <linkfile src="tools" dest="build/tools" />
    </project>
    <project path="build/soong" name="android_build_soong" remote="TeamWin" revision="android-14.1">
        <linkfile src="root.bp" dest="Android.bp" />
        <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
    </project>

    <remove-project name="platform/art" />
    <remove-project name="platform/build/bazel" />
    <remove-project name="platform/build/blueprint" />
    <remove-project name="platform/build/release" />
    <remove-project name="platform/external/starlark-go" />
    <remove-project name="kernel/configs" />
    <remove-project name="platform/prebuilts/bazel/common" />
    <remove-project name="platform/prebuilts/bazel/linux-x86_64" />
    <remove-project name="platform/prebuilts/go/linux-x86" />
    <remove-project name="platform/system/sepolicy" />
    <remove-project name="platform/system/tools/aidl" />
    <remove-project name="platform/system/tools/hidl" />
    <remove-project name="toolchain/pgo-profiles" />

    <project path="art" name="platform/art" remote="aosp" revision="android14-qpr3-release" groups="pdk" />
    <project path="build/bazel" name="platform/build/bazel" remote="aosp" revision="android14-qpr3-release" groups="pdk" />
    <project path="build/blueprint" name="platform/build/blueprint" remote="aosp" revision="android14-qpr3-release" groups="pdk,tradefed" />
    <project path="build/release" name="platform/build/release" remote="aosp" revision="android14-qpr3-release" groups="pdk,tradefed" />
    <project path="external/starlark-go" name="platform/external/starlark-go" remote="aosp" revision="android14-qpr3-release" groups="pdk" />
    <project path="kernel/configs" name="kernel/configs" remote="aosp" revision="android14-qpr3-release" groups="vts,pdk" />
    <project path="prebuilts/bazel/common" name="platform/prebuilts/bazel/common" remote="aosp" revision="android14-qpr3-release" groups="pdk" clone-depth="1" />
    <project path="prebuilts/bazel/linux-x86_64" name="platform/prebuilts/bazel/linux-x86_64" remote="aosp" revision="android14-qpr3-release" groups="linux,pdk" clone-depth="1" />
    <project path="prebuilts/go/linux-x86" name="platform/prebuilts/go/linux-x86" remote="aosp" revision="android14-qpr3-release" groups="linux,pdk,tradefed" clone-depth="1" />
    <project path="system/sepolicy" name="platform/system/sepolicy" remote="aosp" revision="android14-qpr3-release" groups="pdk" />
    <project path="system/tools/aidl" name="platform/system/tools/aidl" remote="aosp" revision="android14-qpr3-release" groups="pdk" />
    <project path="system/tools/hidl" name="platform/system/tools/hidl" remote="aosp" revision="android14-qpr3-release" groups="pdk" />
    <project path="toolchain/pgo-profiles" name="toolchain/pgo-profiles" remote="aosp" revision="android14-qpr3-release" groups="pdk" />

    <!-- Removed by the minimal manifest but required by the QPR3 graph. -->
    <project path="external/gflags" name="platform/external/gflags" remote="aosp" revision="android14-qpr3-release" groups="pdk" />
    <project path="external/guava" name="platform/external/guava" remote="aosp" revision="android14-qpr3-release" groups="pdk" />
    <project path="hardware/google/interfaces" name="platform/hardware/google/interfaces" remote="aosp" revision="android14-qpr3-release" groups="pdk" />
    <project path="hardware/google/pixel" name="platform/hardware/google/pixel" remote="aosp" revision="android14-qpr3-release" groups="generic_fs,pixel" />
</manifest>
